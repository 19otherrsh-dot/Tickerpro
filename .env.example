# TickerPro — Root environment for docker-compose
# Copy to `.env` (gitignored) and fill in real values before `docker compose up`.
# docker-compose substitutes these into the api/worker/db services.

# ── Postgres ──────────────────────────────────────────────────────────
# Used for the db container password AND the api DATABASE_URL.
POSTGRES_PASSWORD=

# ── Auth ──────────────────────────────────────────────────────────────
# Must be a long, random string (min 10 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Meta WhatsApp Cloud API ───────────────────────────────────────────
# META_APP_SECRET enables webhook signature verification (required in prod).
# META_WEBHOOK_VERIFY_TOKEN must be a non-default value in production.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# ── Shopify ───────────────────────────────────────────────────────────
# Enables Shopify webhook HMAC verification (required in prod if used).
SHOPIFY_API_SECRET=

# ── Web (browser-facing) ──────────────────────────────────────────────
# The API URL the browser calls. Baked into the web image at BUILD time
# (docker-compose passes it as a build arg), so a runtime change requires a
# rebuild. Defaults to http://localhost:4000 for local dev.
NEXT_PUBLIC_API_URL=http://localhost:4000
