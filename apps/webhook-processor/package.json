  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "5.9.2"
  }
}
