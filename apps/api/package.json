{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsup src/server.ts src/worker.ts --format esm --outDir dist",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clickhouse/client": "^1.21.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^9.1.0",
    "@fastify/rate-limit": "^10.2.3",
    "@fastify/websocket": "^11.0.3",
    "@tickerpro/database": "*",
    "bcryptjs": "^3.0.2",
    "csv-parse": "^7.0.0",
    "csv-stringify": "^6.8.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "ioredis": "^5.6.1",
    "kafkajs": "^2.2.4",
    "nanoid": "^5.1.5",
    "openai": "^6.37.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "razorpay": "^2.9.6",
    "stripe": "^22.1.1",
    "zod": "^3.25.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "5.9.2",
    "vitest": "^2.1.8"
  }
}
