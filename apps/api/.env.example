# TickerPro — API Environment Variables
# Copy this to .env and fill in values

# ── Server ───────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── Database (PostgreSQL) ────────────────────────────────────────────
DATABASE_URL=postgresql://tickerpro:tickerpro_dev_2026@localhost:5432/tickerpro

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Kafka ────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ── Authentication ───────────────────────────────────────────────────
JWT_SECRET=tickerpro-dev-secret-change-in-production

# ── Meta WhatsApp Cloud API ──────────────────────────────────────────
META_WEBHOOK_VERIFY_TOKEN=tickerpro-verify-token
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=

# ── ClickHouse (Analytics) ──────────────────────────────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=tickerpro
CLICKHOUSE_PASSWORD=tickerpro_dev_2026
CLICKHOUSE_DB=tickerpro_analytics
